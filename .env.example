MADORI_APP_NAME=Madori AI MVP
MADORI_DEBUG=false
MADORI_ENVIRONMENT=development
MADORI_UPLOADS_DIR=uploads
MADORI_OUTPUTS_DIR=outputs
MADORI_RUNS_DIR=runs


GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
USE_GEMINI_ANALYSIS=true
IMAGE_PROVIDER=fluxapi
OUTPUT_MATCH_INPUT_SIZE=true
OUTPUT_SIZE_MODE=fixed
OUTPUT_WIDTH=1200
OUTPUT_HEIGHT=1200
OUTPUT_RESIZE_MODE=contain
OUTPUT_LABEL_EDIT_ENABLED=true
OUTPUT_LABEL_MODE=translate
OUTPUT_LABEL_LANGUAGE=en
LAYOUT_LOCKED_RENDERING_ENABLED=true
LAYOUT_LOCK_MODE=structure_overlay
LAYOUT_LOCK_OUTPUT_NAME=output.png
LAYOUT_LOCK_CREATE_AI_DRAFT=false
STRUCTURE_EXTRACTION_ENABLED=true
STRUCTURE_LINE_DARK_THRESHOLD=180
STRUCTURE_MIN_COMPONENT_AREA=20
STRUCTURE_DILATE_ITERATIONS=1
WATERCOLOR_BACKGROUND_ENABLED=true
WATERCOLOR_BACKGROUND_MODE=soft_paper
WATERCOLOR_DRAW_FRAME=false
WATERCOLOR_BACKGROUND_STRENGTH=0.35
LAYOUT_LOCK_BLEND_NORMALIZED_FLOORPLAN=true
LAYOUT_LOCK_NORMALIZED_FLOORPLAN_OPACITY=1.0
LAYOUT_GUARD_COMPARE_REGION=content_bbox
LAYOUT_GUARD_IGNORE_CANVAS_BORDER=true
LAYOUT_CONTENT_BBOX_PADDING=8
LAYOUT_LOCK_REAPPLY_STRUCTURE=true
LABEL_OCR_PROVIDER=none
LABEL_OCR_ENABLED=false
LABEL_AUTO_APPLY_ENABLED=false
LABEL_AUTO_APPLY_CONFIDENCE_THRESHOLD=0.85
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=
LABEL_OCR_LANGUAGE_HINTS=ja,en

FLUXAPI_API_KEY=
FLUXAPI_MODEL=flux-kontext-pro
FLUXAPI_INPUT_IMAGE_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
FLUXAPI_INPUT_IMAGE_FORMAT=jpg
FLUXAPI_ENABLE_TRANSLATION=false
